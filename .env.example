MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543).
# Do not commit the real value. Password symbols must be URL-encoded.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# The classroom site, with no trailing slash. Example: https://kanasori.vercel.app
APP_ORIGIN=https://your-project.vercel.app

# Any long random string. Vercel Cron sends it when retrying Google Sheets uploads.
CRON_SECRET=

# Optional. Limit student entry to one class, for example class-301.
STUDENT_CLASS_ID=

# Optional Google Sheets sync. Leave empty to keep results only in Supabase.
SHEETS_WEB_APP_URL=
SHEETS_SYNC_TOKEN=
