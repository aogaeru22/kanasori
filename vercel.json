{
  "regions": ["icn1"],
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "{server.mjs,server/**,js/**,css/**,kana/**,fonts/**,audio/**,*.html,style.css,student-app.js,node_modules/kuromoji/dict/**,node_modules/postgres/**}"
    },
    "api/[...path].mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/kuromoji/dict/**"
    },
    "api/cron/sheets.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/kuromoji/dict/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sheets",
      "schedule": "0 15 * * *"
    }
  ]
}
